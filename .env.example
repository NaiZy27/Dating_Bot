BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Telegram ID модератора, которому приходят жалобы (необязательно)
# ADMIN_ID=123456789

# Для локального запуска (python -m app). В docker compose эти два адреса подменяются автоматически.
DATABASE_URL=postgresql+asyncpg://dating:dating@127.0.0.1:5432/dating_db
REDIS_URL=redis://localhost:6379/0

# Учётка Postgres для docker compose (необязательно, по умолчанию dating/dating/dating_db)
POSTGRES_USER=dating
POSTGRES_PASSWORD=dating
POSTGRES_DB=dating_db
